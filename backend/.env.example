# CIVICVISION AI backend — environment template. Copy to `.env` for local development.
# Values marked SECRET must never be committed or placed in any frontend (VITE_*) variable.

ENV=development                       # development | test | production

# --- Database -----------------------------------------------------------------------------
# Local: SQLite file (+ AUTO_CREATE_SCHEMA=true). Supabase: pooler connection string (SECRET), e.g.
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./civicvision-dev.db
AUTO_CREATE_SCHEMA=true               # local SQLite only; must be false in production (use supabase/migrations)

# --- Supabase Auth ------------------------------------------------------------------------
SUPABASE_URL=                         # https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=                  # SECRET — only for projects still on the legacy HS256 JWT secret; leave empty for JWKS signing keys

# --- Storage ------------------------------------------------------------------------------
STORAGE_BACKEND=local                 # local (dev) | supabase (production) | memory (tests)
SUPABASE_SERVICE_ROLE_KEY=            # SECRET — backend only; needed for STORAGE_BACKEND=supabase and provisioning
STORAGE_BUCKET=report-media
LOCAL_MEDIA_DIR=./media
MEDIA_SIGNING_SECRET=change-me        # SECRET — signs local media URLs
SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_MB=5

# --- HTTP / abuse control -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173    # comma-separated exact origins (e.g. your Vercel URL in production)
REPORT_RATE_LIMIT_PER_HOUR=10
UPLOAD_RATE_LIMIT_PER_HOUR=60

# --- AI assistance (optional, Phase 3) -------------------------------------------------
GEMINI_API_KEY=                       # SECRET — free key from https://aistudio.google.com/apikey; empty = "AI assistance unavailable"
GEMINI_MODEL=gemini-3.5-flash-lite
AI_RATE_LIMIT_PER_HOUR=20

# --- Duplicate detection -------------------------------------------------------------------
DUPLICATE_RADIUS_M=150
DUPLICATE_WINDOW_DAYS=30

# --- Realtime (needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) ------------------------------
REALTIME_ENABLED=true
REALTIME_CHANNEL=civic-updates

# --- SLA deadline monitoring --------------------------------------------------------------
SLA_CHECK_INTERVAL_SECONDS=300        # in-process idempotent check; 0 disables
CRON_SECRET=                          # SECRET — enables POST /api/internal/sla/run for an external scheduler

# --- Local development only (refused when ENV=production) ---------------------------------
DEV_LOGIN_ENABLED=false
DEV_JWT_SECRET=                       # SECRET — at least 32 random characters when DEV_LOGIN_ENABLED=true
