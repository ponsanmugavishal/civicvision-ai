# CIVICVISION AI — frontend environment template
# Copy to .env.local and adjust. Never put secret keys in VITE_* variables:
# everything prefixed with VITE_ is bundled into public browser JavaScript.

# "mock" = in-browser demo data, no backend (Phase 1 demo). "api" = FastAPI backend + Supabase Auth.
VITE_DATA_MODE=mock

# FastAPI backend base URL (api mode)
VITE_API_BASE_URL=http://localhost:8000

# Supabase public settings (api mode). The anon/publishable key is public by design — RLS protects data.
# The service-role key must NEVER be placed here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development only: show sign-in buttons for seeded dev accounts (backend DEV_LOGIN_ENABLED=true).
VITE_DEV_LOGIN=false

# Default map view
VITE_MAP_DEFAULT_LAT=13.0500
VITE_MAP_DEFAULT_LNG=80.2400
VITE_MAP_DEFAULT_ZOOM=13

# Tile server (OpenStreetMap standard tiles by default; respect the OSM tile usage policy)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
