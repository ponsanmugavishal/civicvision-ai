# Local integration profile: `npm run dev:api`
# Frontend talks to a locally running FastAPI backend with dev login enabled. No secrets here.
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_LOGIN=true
# Optional — fill in to test real Supabase Auth locally (anon key only, never the service-role key):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
